model User {
  id                                String                        @id @default(uuid()) @db.Uuid
  email                             String                        @db.VarChar(320)
  emailNormalized                   String                        @unique @db.VarChar(320)
  emailAddressEpoch                 Int                           @default(1)
  identityAssurance                 IdentityAssuranceLevel        @default(LOW_ASSURANCE)
  role                              Role
  name                              String?                       @db.VarChar(160)
  status                            UserStatus                    @default(ACTIVE)
  dataProvenance                    DataProvenance                @default(LIVE)
  emailVerifiedAt                   DateTime?                     @db.Timestamptz(3)
  lastLoginAt                       DateTime?                     @db.Timestamptz(3)
  createdAt                         DateTime                      @default(now()) @db.Timestamptz(3)
  updatedAt                         DateTime                      @updatedAt @db.Timestamptz(3)
  credential                        Credential?
  sessions                          Session[]
  passwordResetTokens               PasswordResetToken[]
  emailVerificationChallenges       EmailVerificationChallenge[]
  pendingEmailChanges               PendingEmailChange[]
  authAssuranceEvidence             AuthAssuranceEvidence[]
  notificationOutbox                NotificationOutbox[]
  notificationPreferences           NotificationPreference[]
  notificationPreferenceEvents      NotificationPreferenceEvent[] @relation("NotificationPreferenceOwner")
  notificationPreferenceEventsActed NotificationPreferenceEvent[] @relation("NotificationPreferenceActor")
  authSecurityEvents                AuthSecurityEvent[]
  candidateProfile                  CandidateProfile?
  employerProfile                   EmployerProfile?
  companyMemberships                CompanyMembership[]
  claimRequests                     CompanyClaimRequest[]         @relation("ClaimRequester")
  verificationRequests              CompanyVerificationRequest[]  @relation("VerificationRequester")
  invitationsSent                   CompanyInvitation[]           @relation("InvitationInviter")
  invitationsAccepted               CompanyInvitation[]           @relation("InvitationAcceptor")
  notifications                     Notification[]
  userConsents                      UserConsentEvent[]            @relation("ConsentOwner")
  userConsentsActed                 UserConsentEvent[]            @relation("UserConsentActor")
  candidateConsentsActed            CandidateConsent[]            @relation("CandidateConsentActor")
  privacyRequests                   PrivacyRequest[]              @relation("PrivacyRequester")
  privacyRequestsAssigned           PrivacyRequest[]              @relation("PrivacyAssignee")
  privacyChallenges                 PrivacyIdentityChallenge[]
  privacyExecutionsApproved         PrivacyExecution[]            @relation("PrivacyExecutionApprover")
  privacyExportArtifacts            PrivacyExportArtifact[]
  privacyLegalHolds                 LegalHold[]                   @relation("LegalHoldSubject")
  privacyLegalHoldsCreated          LegalHold[]                   @relation("LegalHoldCreator")
  privacyLegalHoldsReviewed         LegalHold[]                   @relation("LegalHoldReviewer")
  analyticsConsentEvents            AnalyticsConsentEvent[]       @relation("AnalyticsConsentOwner")
  analyticsConsentEventsActed       AnalyticsConsentEvent[]       @relation("AnalyticsConsentActor")
  conversationParticipants          ConversationParticipant[]
  revealConfirmations               IdentityRevealConfirmation[]
  revealGrantsRevoked               IdentityRevealGrant[]         @relation("RevealGrantRevoker")
  messages                          Message[]
  contactRequestsMade               EmployerContactRequest[]
  ordersCreated                     Order[]
  abuseReportsFiled                 AbuseReport[]                 @relation("AbuseReporter")
  abuseReportsAssigned              AbuseReport[]                 @relation("AbuseAssignee")
  auditLogs                         AuditLog[]
  salesLeadsOwned                   SalesLead[]
  systemTasksOwned                  SystemTask[]
  supportCasesRequested             SupportCase[]                 @relation("SupportRequester")
  supportCasesAssigned              SupportCase[]                 @relation("SupportAssignee")
  recruiterMandates                 RecruiterMandate[]            @relation("MandateRecruiter")
  recruiterMandatesGranted          RecruiterMandate[]            @relation("MandateGrantor")
  jobAssignmentsCreated             JobAssignment[]               @relation("JobAssignmentAssigner")
  taxRatesReviewed                  TaxRateVersion[]              @relation("TaxRateReviewer")
  productReleaseDecisions           ProductReleaseDecision[]
  documentUploadIntents             DocumentUploadIntent[]        @relation("DocumentUploadActor")
  documentReadGrants                DocumentReadGrant[]           @relation("DocumentReadGrantActor")
  documentAccessEvents              DocumentAccessEvent[]         @relation("DocumentAccessActor")
  paidScopeDecisions                PaidScopeDecision[]           @relation("PaidScopeDecisionActor")
  reconciliationRuns                ReconciliationRun[]           @relation("ReconciliationRunActor")
  reconciliationItemsResolved       ReconciliationItem[]          @relation("ReconciliationItemResolver")
  refundsRequested                  Refund[]                      @relation("RefundRequester")
  refundsApproved                   Refund[]                      @relation("RefundApprover")
  serviceDeliveryApprovals          ServiceDeliveryAssessment[]   @relation("ServiceDeliveryApprover")
  serviceDeliveryEvents             ServiceDeliveryEvent[]        @relation("ServiceDeliveryEventActor")
  paymentRiskDecisions              PaymentRiskDecision[]         @relation("PaymentRiskDecisionActor")

  @@index([status, role])
  @@index([dataProvenance, status])
}

model Credential {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @db.Uuid
  passwordHash      String   @db.VarChar(255)
  algorithm         String   @db.VarChar(32)
  algorithmVersion  Int
  passwordChangedAt DateTime @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)
  user              User     @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model Session {
  id                  String                  @id @default(uuid()) @db.Uuid
  userId              String                  @db.Uuid
  tokenHash           String                  @unique @db.VarChar(64)
  expiresAt           DateTime                @db.Timestamptz(3)
  absoluteExpiresAt   DateTime                @db.Timestamptz(3)
  createdAt           DateTime                @default(now()) @db.Timestamptz(3)
  rotatedAt           DateTime?               @db.Timestamptz(3)
  revokedAt           DateTime?               @db.Timestamptz(3)
  userAgent           String?                 @db.VarChar(512)
  ipHash              String?                 @db.VarChar(128)
  user                User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  pendingEmailChanges PendingEmailChange[]
  assuranceEvidence   AuthAssuranceEvidence[]

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model PasswordResetToken {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @db.Uuid
  tokenHash          String    @unique @db.VarChar(64)
  expiresAt          DateTime  @db.Timestamptz(3)
  usedAt             DateTime? @db.Timestamptz(3)
  requestedIpHash    String?   @db.VarChar(128)
  requestedUserAgent String?   @db.VarChar(512)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  user               User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([expiresAt, usedAt])
}

model RateLimitBucket {
  id          String   @id @default(uuid()) @db.Uuid
  namespace   String   @db.VarChar(64)
  keyHash     String   @db.VarChar(128)
  windowStart DateTime @db.Timestamptz(3)
  windowEnd   DateTime @db.Timestamptz(3)
  count       Int      @default(0)
  version     Int      @default(1)
  expiresAt   DateTime @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@unique([namespace, keyHash, windowStart])
  @@index([expiresAt])
}

model Canton {
  id                   String                    @id @default(uuid()) @db.Uuid
  code                 String                    @unique @db.Char(2)
  name                 String                    @db.VarChar(120)
  slug                 String                    @unique @db.VarChar(120)
  language             Language
  isActive             Boolean                   @default(true)
  sortOrder            Int                       @default(0)
  cities               City[]
  companies            CompanyLocation[]
  companyRegistrations Company[]                 @relation("CompanyRegistrationCanton")
  candidates           CandidateProfile[]
  jobRevisions         JobRevision[]
  jobsPublished        Job[]                     @relation("PublishedCanton")
  salaryBands          SalaryBand[]
  clusterAssessments   ClusterLaunchAssessment[]
  metricDailyRows      MetricDaily[]
  createdAt            DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                  @updatedAt @db.Timestamptz(3)

  @@index([slug])
  @@index([isActive, sortOrder])
}

model City {
  id               String            @id @default(uuid()) @db.Uuid
  cantonId         String            @db.Uuid
  name             String            @db.VarChar(160)
  slug             String            @db.VarChar(160)
  latitude         Decimal?          @db.Decimal(9, 6)
  longitude        Decimal?          @db.Decimal(9, 6)
  isActive         Boolean           @default(true)
  sortOrder        Int               @default(0)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
  canton           Canton            @relation(fields: [cantonId], references: [id], onDelete: Restrict)
  companyLocations CompanyLocation[]
  jobRevisions     JobRevision[]
  jobsPublished    Job[]             @relation("PublishedCity")

  @@unique([cantonId, slug])
  @@unique([id, cantonId])
  @@index([cantonId])
  @@index([cantonId, isActive, sortOrder])
}

model Category {
  id                   String                        @id @default(uuid()) @db.Uuid
  parentId             String?                       @db.Uuid
  name                 String                        @db.VarChar(160)
