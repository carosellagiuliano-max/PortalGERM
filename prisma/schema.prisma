/// Commercial evidence gate for one explicitly named paid launch scope.
/// Rows are immutable decision evidence; a later NO_GO/REVOKED row supersedes
/// an earlier GO instead of mutating history.
model PaidScopeDecision {
  id              String                   @id @default(uuid()) @db.Uuid
  scopeCode       String                   @db.VarChar(64)
  packageCode     String                   @db.VarChar(64)
  status          PaidScopeDecisionStatus
  maximumMode     OperationsActivationMode @default(SANDBOX)
  decisionRef     String                   @unique @db.VarChar(255)
  evidenceDigest  String                   @db.Char(64)
  sampleSize      Int
  thresholdCode   String                   @db.VarChar(64)
  reasonCode      String                   @db.VarChar(64)
  decidedByUserId String                   @db.Uuid
  effectiveAt     DateTime                 @db.Timestamptz(3)
  expiresAt       DateTime                 @db.Timestamptz(3)
  createdAt       DateTime                 @default(now()) @db.Timestamptz(3)
  decidedBy       User                     @relation("PaidScopeDecisionActor", fields: [decidedByUserId], references: [id], onDelete: Restrict)
  paymentAttempts PaymentAttempt[]

  @@index([scopeCode, packageCode, status, effectiveAt, expiresAt])
}

