  environment         String                   @db.VarChar(32)
  useCase             String                   @db.VarChar(96)
  adapterKey          String                   @db.VarChar(96)
  adapterVersion      String                   @db.VarChar(32)
  mode                OperationsActivationMode @default(DISABLED)
  configurationDigest String                   @db.Char(64)
  secretVersionRef    String?                  @db.VarChar(128)
  region              String?                  @db.VarChar(64)
  dpaRef              String?                  @db.VarChar(255)
  contractRef         String?                  @db.VarChar(255)
  approvalRef         String?                  @db.VarChar(255)
  evidenceDigest      String                   @db.Char(64)
  owner               String                   @db.VarChar(160)
  runbookRef          String                   @db.VarChar(255)
  health              OperationsHealthStatus   @default(UNKNOWN)
  healthCheckedAt     DateTime?                @db.Timestamptz(3)
  quotaUnits          Int?
  sustainableCapacity Int?
  unitCostMicros      BigInt?
