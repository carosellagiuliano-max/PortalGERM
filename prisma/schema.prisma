  currentVersion     DocumentVersion?  @relation("CurrentDocumentVersion", fields: [currentVersionId, candidateProfileId], references: [id, candidateProfileId], onDelete: Restrict)
  versions           DocumentVersion[] @relation("DocumentVersions")

  @@unique([candidateProfileId, purpose])
  @@unique([id, candidateProfileId])
  @@unique([currentVersionId, candidateProfileId])
  @@index([candidateProfileId, updatedAt])
}

