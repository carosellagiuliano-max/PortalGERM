  id                    String                          @id @default(uuid()) @db.Uuid
  documentId            String                          @db.Uuid
  candidateProfileId    String                          @db.Uuid
  sequence              Int
  objectKey             String                          @unique @db.VarChar(512)
  providerObjectVersion String                          @db.VarChar(128)
  safeFilename          String                          @db.VarChar(255)
  declaredMimeType      String                          @db.VarChar(128)
  detectedMimeType      String?                         @db.VarChar(128)
  sizeBytes             Int?
  sha256                String?                         @db.Char(64)
  classification        DocumentClassification          @default(HIGHLY_SENSITIVE)
  status                VaultDocumentStatus             @default(UPLOADING)
  encryptionKeyVersion  String                          @db.VarChar(32)
