  evidenceDigest        String                   @db.Char(64)
  providerUseCase       String?                  @db.VarChar(96)
  leaseMilliseconds     Int                      @default(60000)
  heartbeatMilliseconds Int                      @default(20000)
  batchSize             Int                      @default(25)
  maxAttempts           Int                      @default(8)
  maxConcurrency        Int                      @default(1)
  killSwitchEngaged     Boolean                  @default(true)
  effectiveAt           DateTime?                @db.Timestamptz(3)
  expiresAt             DateTime?                @db.Timestamptz(3)
  revokedAt             DateTime?                @db.Timestamptz(3)
  revokeReasonCode      String?                  @db.VarChar(64)
  createdAt             DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                 @updatedAt @db.Timestamptz(3)

  @@index([environment, handlerKey, handlerVersion, createdAt])
  @@index([environment, mode, effectiveAt, expiresAt])
}

model ProviderActivation {
