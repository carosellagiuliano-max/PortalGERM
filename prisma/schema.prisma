  allowsSelfService Boolean
  reasonCode        String          @db.VarChar(64)
  rationale         String          @db.VarChar(1000)
  decidedByUserId   String          @db.Uuid
  expiresAt         DateTime        @db.Timestamptz(3)
  idempotencyKey    String          @unique @db.VarChar(128)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  product           Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  decidedBy         User            @relation(fields: [decidedByUserId], references: [id], onDelete: Restrict)
  releasedVersion   ProductVersion?

  @@index([productId, expiresAt])
}

