{
  "name": "swisstalenthub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typegen": "next typegen",
    "typecheck": "npm run typegen && tsc --noEmit",
    "test": "tsx scripts/vitest-unit-suite.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:integration": "npm run env:validate && tsx scripts/vitest-integration-suite.ts",
    "test:e2e": "npm run test:e2e:http && npm run test:e2e:browser",
    "test:e2e:http": "tsx scripts/http-smoke.ts",
    "test:e2e:browser": "tsx --conditions react-server scripts/phase17-browser-gate.ts",
    "test:e2e:list": "playwright test --config=playwright.config.ts --list",
    "test:e2e:hsts": "tsx scripts/http-smoke.ts --production-hsts",
    "env:init": "tsx scripts/env-init.ts",
    "env:validate": "tsx scripts/validate-env.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "npm run env:validate && prisma migrate deploy",
    "db:migrate:dev": "tsx scripts/require-local-database.ts && prisma migrate dev",
    "db:migrate:status": "npm run env:validate && prisma migrate status",
    "db:seed": "npm run env:validate && tsx prisma/seed.ts",
    "seed:verify": "npm run env:validate && tsx scripts/seed-verify.ts",
    "db:smoke": "npm run env:validate && tsx scripts/db-smoke.ts",
    "security:maintenance": "npm run env:validate && tsx scripts/security-maintenance.ts",
    "notifications:dispatch": "tsx --conditions react-server scripts/phase20-notification-dispatch.ts",
    "worker:start": "tsx --conditions react-server scripts/phase23-worker.ts",
    "worker:once": "tsx --conditions react-server scripts/phase23-worker.ts --once",
    "worker:sandbox": "tsx --conditions react-server scripts/phase23-sandbox-control.ts",
    "worker:chaos": "tsx --conditions react-server scripts/phase23-worker-chaos.ts --scenario=before-effect,after-effect-before-ack,heartbeat-loss,restart,rolling-deploy",
    "worker:benchmark": "tsx --conditions react-server scripts/phase23-capacity-benchmark.ts --profile=lc3 --items=10000 --workers=4",
    "providers:smoke": "tsx --conditions react-server scripts/phase23-provider-activation-smoke.ts",
    "ops:staging-smoke": "tsx scripts/phase23-staging-deploy-smoke.ts",
    "ops:incident-drill": "tsx scripts/phase23-incident-drill.ts",
    "ops:staging-restore": "tsx scripts/phase23-backup-restore-drill.ts",
    "documents:scan": "tsx --conditions react-server scripts/phase21-document-scan.ts",
    "documents:reconcile": "tsx --conditions react-server scripts/phase21-document-reconcile.ts",
    "documents:smoke": "tsx scripts/phase21-storage-scanner-smoke.ts --mode=sandbox --fixture-manifest=tests/fixtures/documents/manifest.json",
    "privacy:failure-drill": "node --conditions=react-server --import tsx scripts/phase22-privacy-failure-drill.ts --matrix=all-processors",
    "privacy:restore-drill": "node --conditions=react-server --import tsx scripts/phase22-erasure-restore-drill.ts",
    "privacy:load": "node --expose-gc --conditions=react-server --import tsx scripts/phase22-privacy-load.ts",
    "ops:backup": "tsx scripts/ops/backup.ts",
    "ops:restore": "tsx scripts/ops/restore.ts",
    "ops:release-smoke": "tsx scripts/ops/release-smoke.ts",
    "ops:password-reset-smoke": "tsx scripts/ops/password-reset-smoke.ts",
    "plan:audit": "tsx scripts/plan-evidence-audit.ts",
    "route:audit": "tsx scripts/route-inventory-audit.ts && tsx scripts/phase33-surface-inventory-audit.ts",
    "route:audit:update": "tsx scripts/route-inventory-audit.ts --write && tsx scripts/phase33-surface-inventory-audit.ts --write",
    "security:release-scan": "tsx scripts/release-secret-scan.ts",
    "license:audit": "tsx scripts/license-audit.ts",
    "phase33:audit": "tsx scripts/phase33-audit.ts",
    "phase33:ci:report-reference": "tsx scripts/phase33-ci-report-reference.ts",
    "phase33:ci:evidence-verify": "tsx scripts/phase33-ci-evidence-verify.ts",
    "phase33:scale": "tsx --conditions react-server scripts/phase33-scale-readiness.ts",
    "phase33:bundle": "tsx scripts/phase33-build-runtime.ts",
    "phase33:runtime": "tsx scripts/phase33-compose.ts",
    "phase33:runtime:config:local": "tsx scripts/phase33-compose.ts config --profile=local-mock",
    "phase33:runtime:config:contract": "tsx scripts/phase33-compose.ts config --profile=production-contract",
    "phase33:runtime:up:local": "tsx scripts/phase33-compose.ts up --profile=local-mock",
    "phase33:runtime:up:contract": "tsx scripts/phase33-compose.ts up --profile=production-contract",
    "phase33:runtime:smoke:contract": "tsx scripts/phase33-compose.ts smoke --profile=production-contract",
    "phase33:runtime:down:local": "tsx scripts/phase33-compose.ts down --profile=local-mock",
    "phase33:runtime:down:contract": "tsx scripts/phase33-compose.ts down --profile=production-contract",
    "phase33:contract:bootstrap": "tsx --conditions react-server scripts/phase33-contract-bootstrap.ts",
    "phase33:contract:smoke:internal": "tsx --conditions react-server scripts/phase33-contract-smoke-internal.ts",
    "phase33:local:bootstrap": "tsx --conditions react-server scripts/phase33-local-bootstrap.ts",
    "phase33:local:smoke:internal": "tsx --conditions react-server scripts/phase33-local-smoke-internal.ts",
    "phase33:release:technical": "tsx scripts/phase33-release-gate.ts --mode=technical",
    "phase33:release:activation": "tsx scripts/phase33-release-gate.ts --mode=activation",
    "phase33:manifest": "tsx scripts/phase33-technical-manifest.ts",
    "phase33:providers": "tsx scripts/phase33-provider-gate.ts",
    "phase33:e2e": "tsx --conditions react-server scripts/phase17-browser-gate.ts tests/e2e/flows/phase33-public-candidate.spec.ts tests/e2e/flows/phase33-employer-recruiter.spec.ts tests/e2e/flows/phase33-privileged-operations.spec.ts",
    "test:phase33": "tsx scripts/phase33-test-report.ts",
    "test:phase33:runtime": "vitest run --config vitest.config.ts tests/unit/release/phase33-release-verdict.test.ts tests/unit/release/phase33-test-report-contract.test.ts tests/unit/ops/phase33-runtime-roles.test.ts",
    "test:phase32": "vitest run --config vitest.config.ts tests/unit/release",
    "test:release:recovery": "tsx scripts/phase18-release-gate.ts",
    "release:audit": "tsx scripts/phase32-release-gate.ts",
    "release:finalize": "tsx scripts/phase32-release-gate.ts --finalize-only",
    "release:verify": "tsx scripts/phase32-release-gate.ts --verify-only",
    "test:release": "npm run release:audit -- --requested-class=LC1",
    "db:studio": "tsx scripts/require-local-database.ts && prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1101.0",
    "@base-ui/react": "1.6.0",
    "@fontsource-variable/inter": "5.3.0",
    "@hookform/resolvers": "5.4.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@radix-ui/react-slot": "1.2.4",
    "@simplewebauthn/browser": "13.3.0",
    "@simplewebauthn/server": "13.3.2",
    "bcryptjs": "3.0.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.25.0",
    "next": "16.2.11",
    "next-themes": "0.4.6",
    "pg": "8.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.82.0",
    "server-only": "0.0.1",
    "sonner": "2.0.7",
    "stripe": "22.3.2",
    "svix": "1.99.1",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "dotenv": "17.4.2",
    "esbuild": "0.28.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "jsdom": "29.1.1",
    "postcss": "8.5.23",
    "prisma": "7.9.1",
    "shadcn": "4.13.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "prisma@7.9.1": true,
    "sharp@0.35.3": true,
    "unrs-resolver@1.12.2": true,
    "@prisma/engines@7.9.1": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "fast-uri": "3.1.5",
    "hono": "4.12.34",
    "ip-address": "10.3.1",
    "postcss": "$postcss",
    "sharp": "0.35.3",
    "undici": "7.29.0",
    "next@16.2.11": {
      "postcss": "$postcss"
    }
  }
}
