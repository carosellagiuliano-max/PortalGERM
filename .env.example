# This catalog contains unmistakable placeholders and is intentionally not
# runnable when copied verbatim. For Local development, run `npm run env:init`.
#
# Runtime identity. APP_BUILD_ID must identify the deployed commit in
# Staging/Production.
APP_ENV=local
NODE_ENV=development

# Required PostgreSQL application target. TEST_DATABASE_URL is Local/CI-only,
# must name a separate test database and must be empty in Staging/Production.
DATABASE_URL=postgresql://swisstalenthub:local-development-only@127.0.0.1:5434/swisstalenthub?schema=public
TEST_DATABASE_URL=postgresql://swisstalenthub_test:local-test-only@127.0.0.1:5435/swisstalenthub_test?schema=public

# Required credential-free application origin and public product name.
# Staging/Production APP_URL must use HTTPS.
APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_APP_NAME=SwissTalentHub
APP_BUILD_ID=local-development

# Required server secret: exactly 32 CSPRNG bytes encoded as canonical base64.
SESSION_SECRET=REPLACE_WITH_BASE64_32_BYTES

# Required comma-separated `version:base64-32-byte-key` keyrings. The first
# entry is the active writer; unique older entries remain read-only for
# rotation until no persisted row references them. Never reuse key material.
AUDIT_IP_HASH_KEYS=v1:REPLACE_WITH_BASE64_32_BYTES
RADAR_OPAQUE_LOOKUP_KEYS=v1:REPLACE_WITH_BASE64_32_BYTES
RADAR_OPAQUE_ENCRYPTION_KEYS=v1:REPLACE_WITH_BASE64_32_BYTES
REVEAL_CONFIRMATION_KEYS=v1:REPLACE_WITH_BASE64_32_BYTES
PII_REVEAL_KEYS=v1:REPLACE_WITH_BASE64_32_BYTES
# Required before Phase-20 outbox producers or provider sandbox are enabled.
NOTIFICATION_DELIVERY_KEYS=v1:REPLACE_WITH_BASE64_32_BYTES
DOCUMENT_STORAGE_KEYS=
PRIVACY_EXPORT_KEYS=

# Required. Shared PostgreSQL is mandatory in Staging/Production; the memory
# adapter is Local/Test-only.
RATE_LIMIT_BACKEND=postgres

# Number of trusted reverse-proxy hops in X-Forwarded-For. Keep 0 locally;
# staging/production must configure the exact ingress topology (1-8), and the
# outer ingress must replace any client-supplied X-Forwarded-For value.
TRUSTED_PROXY_HOPS=0

# Guarded Local-only mailbox. Keep disabled unless a local test explicitly
# needs it. Staging/Production and production builds require `false`.
ENABLE_LOCAL_MOCK_MAILBOX=false
DEV_MAILBOX_SECRET=REPLACE_WITH_BASE64URL_AT_LEAST_32_RANDOM_BYTES

# Phase-20 identity/delivery activation ledger. Defaults are fail-closed.
IDENTITY_VERIFICATION_ENFORCEMENT=false
LOGIN_EMAIL_CHANGE=false
ADMIN_MFA_REQUIRED=false
PRIVILEGED_STEP_UP_MODE=disabled
TRUST_RISK_MODE=observe
# Phase-26 company trust. All public effects stay closed until separate
# provider, legal, reviewer-capacity and rollout evidence exists.
COMPANY_TRUST_V2=disabled
COMPANY_DOMAIN_CHALLENGE=false
COMPANY_REGISTER_CHECK=false
COMPANY_VERIFICATION_DOCUMENT=false
COMPANY_STRONG_BADGE=false
COMPANY_TRUST_PUBLIC_ELIGIBILITY=false
COMPANY_TRUST_RAPID_REVOKE=false
LEGACY_COMPANY_REVERIFY=false
COMPANY_REGISTER_PROVIDER_MODE=disabled
COMPANY_DOMAIN_PROVIDER_MODE=disabled
COMPANY_VERIFICATION_COHORT=none
# Phase-27 identity/persona expansion. Defaults keep every new runtime surface
# absent. technical activation progresses independently from Demand/LIVE Go.
IDENTITY_PERSONA_V2=disabled
EXISTING_IDENTITY_INVITATION=false
PERSONA_PORTAL_SWITCH=false
PERSONA_PRIVACY_V2=false
PERSONA_LEGACY_CONTRACT=false
# Phase-28 independent recruiting tracks. Technical Local/CI validation uses
# `test`; production activation remains disabled until Demand, Privacy and Ops
# owners approve the individual track.
EXTERNAL_APPLICATION_TRACKER=disabled
INTERVIEW_SCHEDULER=disabled
BREAK_GLASS_ENABLED=false
NOTIFICATION_OUTBOX_PRODUCERS=false
EMAIL_PROVIDER_MODE=disabled
NOTIFICATION_DISPATCH=paused
OPTIONAL_EMAIL=false
DELIVERY_REPLAY=false
EMAIL_FROM=

# Phase-23 durable worker runtime. The default is deliberately paused.
# sandbox_command is Local/CI-only. Staging/Production autonomous boot still
# requires a complete persisted handler/provider activation ledger.
WORKER_RUNTIME=paused
WORKER_SANDBOX_REPLAY=false
PAYMENT_PROVIDER_MODE=disabled
PAYMENT_SANDBOX_COHORT=none
REAL_PAYMENT_INGESTION=false
REAL_PAYMENT_PROJECTION=false
PAID_SELF_SERVICE=false
FINANCE_REPAIR_ACTIONS=false
PAID_SERVICE_RECOVERY=false

# Local recipient default only. Configure a reviewed real distribution in
# Staging/Production.
ABUSE_REPORT_ADMIN_EMAILS=admin@demo.ch

LOG_LEVEL=info

# Ops-only recovery values; leave empty for ordinary application runtime.
# BACKUP_AGE_RECIPIENT is one public X25519 recipient (`age1...`).
BACKUP_AGE_RECIPIENT=
# Absolute secret-mounted identity path outside the repository, for example
# `/run/secrets/swisstalenthub-backup-age-identity` on Linux or a protected
# absolute path outside the checkout on Windows. Never put identity key
# material in this file, the repository, logs or BUILD_REPORT.
BACKUP_AGE_IDENTITY_FILE=

# Provider credentials never activate a provider on their own. Phase 20 permits
# only the explicit `resend_sandbox` mode; no LIVE mode exists.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ACCOUNT_ID=
STRIPE_SECRET_VERSION=
EMAIL_PROVIDER_API_KEY=
OPENAI_API_KEY=
STORAGE_ENDPOINT=
DOCUMENT_VAULT_WRITES=false
DOCUMENT_STORAGE_MODE=disabled
DOCUMENT_SCANNER_MODE=disabled
DOCUMENT_CLEAN_READS=false
DOCUMENT_RECONCILIATION=disabled
DOCUMENT_BULK_ACCESS=false
DOCUMENT_VAULT_COHORT=none
DOCUMENT_STORAGE_ROOT=
DOCUMENT_STORAGE_REGION=local-test
LEGAL_PUBLICATION_PRIVACY=false
LEGAL_PUBLICATION_TERMS=false
LEGAL_PUBLICATION_IMPRINT=false
PRIVACY_EXPORT_V2=false
PRIVACY_CORRECTION_EXECUTION=false
PRIVACY_ERASURE_EXECUTION=false
PRIVACY_PROCESSING_MODE=disabled
PRIVACY_PROCESSING_COHORT=none
PRIVACY_EXPORT_STORAGE_MODE=disabled
PRIVACY_EXPORT_STORAGE_ROOT=
PRIVACY_EXPORT_STORAGE_REGION=local-test
PRIVACY_PROVIDER_POSTGRES=false
PRIVACY_PROVIDER_DOCUMENTS=false
PRIVACY_PROVIDER_EMAIL=false
PRIVACY_PROVIDER_PAYMENT=false
PRIVACY_PROVIDER_ANALYTICS=false
PRIVACY_PROVIDER_BACKUP=false
OPTIONAL_ANALYTICS_NAVIGATION=false
OPTIONAL_ANALYTICS_CONVERSION=false
SEARCH_LEARNING_COLLECTION=false
JOBROOM_API_URL=
MAPS_API_KEY=
